#!/usr/bin/env bash
# ==============================================================================
# Script: td-backup
# Description: Smart Backup Tool for Termux Desktop (Full Rootfs or Config Only)
# Usage: td-backup [--full|--config|--list|--help] [--output <path>]
# Repository: https://github.com/supardi98/termux-desktop
# ==============================================================================

set -eo pipefail

readonly BACKUP_DEFAULT_DIR="/sdcard/Download/TermuxDesktopBackups"
readonly FALLBACK_DIR="${HOME}/TermuxDesktopBackups"
readonly DATE_TAG=$(date +"%Y%m%d_%H%M%S")

# Styling
BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
RED="\033[0;31m"
RESET="\033[0m"

log_info()    { echo -e "${BLUE}[i]${RESET} $1"; }
log_success() { echo -e "${GREEN}[✓]${RESET} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${RESET} $1"; }
log_error()   { echo -e "${RED}[☓]${RESET} $1"; }

get_backup_dir() {
    if [ -d "/sdcard/Download" ] && [ -w "/sdcard/Download" ]; then
        mkdir -p "$BACKUP_DEFAULT_DIR" 2>/dev/null || true
        if [ -w "$BACKUP_DEFAULT_DIR" ]; then
            echo "$BACKUP_DEFAULT_DIR"
            return 0
        fi
    fi
    mkdir -p "$FALLBACK_DIR" 2>/dev/null || true
    echo "$FALLBACK_DIR"
}

list_backups() {
    local bdir
    bdir=$(get_backup_dir)
    echo ""
    echo -e "${BOLD}Daftar Cadangan Termux Desktop:${RESET}"
    echo -e "Direktori: ${CYAN}${bdir}${RESET}"
    echo "------------------------------------------------------------"
    
    local count=0
    for f in "$bdir"/*.tar.zst "$bdir"/*.tar.gz; do
        if [ -f "$f" ]; then
            local size
            size=$(du -h "$f" 2>/dev/null | awk '{print $1}')
            local mtime
            mtime=$(date -r "$f" +"%Y-%m-%d %H:%M:%S" 2>/dev/null || stat -c "%y" "$f" 2>/dev/null | cut -d'.' -f1)
            local fname
            fname=$(basename "$f")
            
            local type="LENGKAP (Full)"
            if [[ "$fname" == *"config"* ]]; then
                type="KONFIGURASI (Config Only)"
            fi
            
            echo -e "📦 ${BOLD}${fname}${RESET}"
            echo -e "   Tipe   : ${GREEN}${type}${RESET}"
            echo -e "   Ukuran : ${YELLOW}${size}${RESET}"
            echo -e "   Waktu  : ${mtime}"
            echo ""
            count=$((count + 1))
        fi
    done
    
    if [ "$count" -eq 0 ]; then
        echo -e "${YELLOW}Belum ada file cadangan yang ditemukan.${RESET}"
        echo -e "Jalankan ${CYAN}td-backup${RESET} untuk membuat cadangan pertama Anda."
    else
        echo "------------------------------------------------------------"
        echo -e "Total: ${BOLD}${count}${RESET} file cadangan."
        echo -e "Pulihkan dengan perintah: ${CYAN}td-restore <nama_file>${RESET}"
    fi
    echo ""
}

show_help() {
    echo ""
    echo -e "${BOLD}td-backup - Alat Pencadangan Cerdas Termux Desktop${RESET}"
    echo ""
    echo "Penggunaan: td-backup [OPSI]"
    echo ""
    echo "Opsi:"
    echo "  --full         Cadangkan seluruh sistem Debian + Desktop + Konfigurasi (Default)"
    echo "  --config       Cadangkan file konfigurasi dan dotfiles saja (~5-10 MB, hitungan detik)"
    echo "  --list         Tampilkan daftar semua file cadangan yang tersedia"
    echo "  --output <dir> Tentukan folder tujuan penyimpanan kustom"
    echo "  -h, --help     Tampilkan panduan bantuan ini"
    echo ""
    echo "Contoh:"
    echo "  td-backup                 # Cadangkan sistem lengkap ke folder Download HP"
    echo "  td-backup --config        # Cadangkan konfigurasi & dotfiles cepat"
    echo "  td-backup --list          # Cek daftar file backup yang sudah ada"
    echo ""
}

# Determine compressor
get_compressor() {
    if command -v zstd >/dev/null 2>&1; then
        echo "zstd"
    elif [ -x "/data/data/com.termux/files/usr/bin/zstd" ]; then
        echo "/data/data/com.termux/files/usr/bin/zstd"
    else
        echo "gzip"
    fi
}

run_backup_full() {
    local target_dir="$1"
    local comp
    comp=$(get_compressor)
    local ext="tar.zst"
    [ "$comp" = "gzip" ] && ext="tar.gz"
    
    local out_file="${target_dir}/termux_desktop_full_${DATE_TAG}.${ext}"
    local sha_file="${out_file}.sha256"
    
    echo ""
    echo -e "${BOLD}============================================================${RESET}"
    echo -e " ${GREEN}📦 Memulai Pencadangan Sistem Lengkap (Full OS + Desktop)${RESET}"
    echo -e "${BOLD}============================================================${RESET}"
    log_info "Tujuan File  : ${CYAN}${out_file}${RESET}"
    log_info "Metode Kompresi: ${BOLD}${comp}${RESET}"
    echo ""

    # Select specific Debian and Termux targets to prevent traversing Android host /system /apex /proc
    local targets=()
    for d in etc usr var root opt srv home/supardi; do
        [ -e "/$d" ] && targets+=("$d")
    done

    for td in \
        "data/data/com.termux/files/usr/etc/termux-desktop" \
        "data/data/com.termux/files/usr/etc/ssh/sshd_config.d" \
        "data/data/com.termux/files/usr/lib/libssh_pts_fix.so" \
        "data/data/com.termux/files/home/.termux" \
        "data/data/com.termux/files/home/.termux_authinfo" \
        "data/data/com.termux/files/home/.ssh"
    do
        [ -e "/$td" ] && targets+=("$td")
    done

    # Exclusions
    local excludes=(
        --exclude="*/storage"
        --exclude="*/storage/*"
        --exclude="*/Music"
        --exclude="*/Pictures"
        --exclude="*/Videos"
        --exclude="*/Downloads"
        --exclude="*/.cache"
        --exclude="*/.cache/*"
        --exclude="*/.local/share/Trash/*"
        --exclude="*/TermuxDesktopBackups"
        --exclude="*/TermuxDesktopBackups/*"
        --exclude="*/.gemini"
        --exclude="*/.gemini/*"
        --exclude="var/cache/apt/archives/*"
        --exclude="var/tmp/*"
        --exclude="tmp/*"
    )

    log_info "Mengumpulkan data sistem Debian & konfigurasi..."
    
    local start_time
    start_time=$(date +%s)

    # Use pv if available for visual progress
    if command -v pv >/dev/null 2>&1; then
        if [ "$comp" = "gzip" ]; then
            tar -cpf - "${excludes[@]}" -C / "${targets[@]}" 2>/dev/null | pv -s 2600M -N "Proses Backup" | gzip -1 > "$out_file"
        else
            tar -cpf - "${excludes[@]}" -C / "${targets[@]}" 2>/dev/null | pv -s 2600M -N "Proses Backup" | "$comp" -T0 -3 > "$out_file"
        fi
    else
        log_info "Sedang mengompresi arsip (harap tunggu sekitar 1-2 menit)..."
        if [ "$comp" = "gzip" ]; then
            tar -czpf "$out_file" "${excludes[@]}" -C / "${targets[@]}" 2>/dev/null
        else
            tar -cpf - "${excludes[@]}" -C / "${targets[@]}" 2>/dev/null | "$comp" -T0 -3 > "$out_file"
        fi
    fi

    local end_time
    end_time=$(date +%s)
    local duration=$((end_time - start_time))

    if [ -f "$out_file" ] && [ -s "$out_file" ]; then
        local file_size
        file_size=$(du -h "$out_file" | awk '{print $1}')
        
        # Create sha256 checksum
        log_info "Membuat checksum SHA256 integritas file..."
        (cd "$(dirname "$out_file")" && sha256sum "$(basename "$out_file")" > "$sha_file")

        echo ""
        echo -e "${BOLD}============================================================${RESET}"
        log_success "Pencadangan Berhasil Diselesaikan!"
        echo -e "${BOLD}============================================================${RESET}"
        echo -e " Lokasi File : ${CYAN}${out_file}${RESET}"
        echo -e " Ukuran File : ${YELLOW}${file_size}${RESET}"
        echo -e " Waktu Proses: ${duration} detik"
        echo -e " Checksum    : ${sha_file}"
        echo ""
        echo -e " ${BOLD}Cara Memulihkan (Restore):${RESET}"
        echo -e "   👉 Di HP ini atau HP baru, cukup jalankan:"
        echo -e "      ${CYAN}td-restore $(basename "$out_file")${RESET}"
        echo -e "   👉 File ini tersimpan di folder Download HP Anda, siap"
        echo -e "      dipindahkan ke laptop, Google Drive, atau flashdisk."
        echo -e "${BOLD}============================================================${RESET}"
        echo ""
    else
        log_error "Gagal membuat file cadangan."
        return 1
    fi
}

run_backup_config() {
    local target_dir="$1"
    local comp
    comp=$(get_compressor)
    local ext="tar.zst"
    [ "$comp" = "gzip" ] && ext="tar.gz"
    
    local out_file="${target_dir}/termux_desktop_config_${DATE_TAG}.${ext}"
    local sha_file="${out_file}.sha256"
    
    echo ""
    echo -e "${BOLD}============================================================${RESET}"
    echo -e " ${GREEN}⚡ Memulai Pencadangan Cepat Konfigurasi & Dotfiles${RESET}"
    echo -e "${BOLD}============================================================${RESET}"
    log_info "Tujuan File  : ${CYAN}${out_file}${RESET}"
    echo ""

    local items_to_backup=()
    local user_home="/home/supardi"
    [ ! -d "$user_home" ] && user_home="$HOME"

    # Important dotfiles & folders
    for item in \
        "$user_home/.config" \
        "$user_home/.zshrc" \
        "$user_home/.aliases" \
        "$user_home/.shell_rc_content" \
        "$user_home/.nanorc" \
        "$user_home/.gitconfig" \
        "$user_home/.termux" \
        "$user_home/.vnc" \
        "$user_home/.ssh" \
        "$user_home/.termux_authinfo" \
        "$user_home/.first_pass_change_marker" \
        "/usr/local/bin" \
        "/data/data/com.termux/files/usr/etc/termux-desktop" \
        "/data/data/com.termux/files/usr/etc/ssh/sshd_config.d" \
        "/data/data/com.termux/files/usr/lib/libssh_pts_fix.so" \
        "/data/data/com.termux/files/usr/bin/clip" \
        "/data/data/com.termux/files/usr/bin/patch-novnc-clipboard.py"
    do
        if [ -e "$item" ]; then
            items_to_backup+=("$item")
        fi
    done

    local excludes=(
        --exclude="*/.cache/*"
        --exclude="*/google-chrome/*"
        --exclude="*/chromium/*"
        --exclude="*/firefox/*.default*/*cache*"
        --exclude="*/.gemini/*"
    )

    log_info "Mengemas konfigurasi penting (${#items_to_backup[@]} item ditemukan)..."

    if [ "$comp" = "gzip" ]; then
        tar -czpf "$out_file" "${excludes[@]}" "${items_to_backup[@]}" 2>/dev/null || true
    else
        tar -cpf - "${excludes[@]}" "${items_to_backup[@]}" 2>/dev/null | "$comp" -T0 -3 > "$out_file"
    fi

    if [ -f "$out_file" ] && [ -s "$out_file" ]; then
        local file_size
        file_size=$(du -h "$out_file" | awk '{print $1}')
        (cd "$(dirname "$out_file")" && sha256sum "$(basename "$out_file")" > "$sha_file")

        echo ""
        echo -e "${BOLD}============================================================${RESET}"
        log_success "Pencadangan Konfigurasi Berhasil!"
        echo -e "${BOLD}============================================================${RESET}"
        echo -e " Lokasi File : ${CYAN}${out_file}${RESET}"
        echo -e " Ukuran File : ${YELLOW}${file_size}${RESET} (Sangat Ringan)"
        echo -e " Checksum    : ${sha_file}"
        echo ""
        echo -e " ${BOLD}Cara Memulihkan (Restore):${RESET}"
        echo -e "   👉 ${CYAN}td-restore $(basename "$out_file")${RESET}"
        echo -e "${BOLD}============================================================${RESET}"
        echo ""
    else
        log_error "Gagal membuat cadangan konfigurasi."
        return 1
    fi
}

# Parse options
MODE="full"
CUSTOM_OUT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --full)
            MODE="full"
            shift
            ;;
        --config|--lite)
            MODE="config"
            shift
            ;;
        --list|-l)
            list_backups
            exit 0
            ;;
        --output|-o)
            shift
            CUSTOM_OUT="$1"
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            echo -e "${RED}Opsi tidak dikenal: $1${RESET}"
            show_help
            exit 1
            ;;
    esac
done

TARGET_DIR=$(get_backup_dir)
if [ -n "$CUSTOM_OUT" ]; then
    mkdir -p "$CUSTOM_OUT" 2>/dev/null || true
    if [ -d "$CUSTOM_OUT" ] && [ -w "$CUSTOM_OUT" ]; then
        TARGET_DIR="$CUSTOM_OUT"
    else
        log_warn "Direktori kustom '$CUSTOM_OUT' tidak dapat ditulis, menggunakan: $TARGET_DIR"
    fi
fi

if [ "$MODE" = "config" ]; then
    run_backup_config "$TARGET_DIR"
else
    run_backup_full "$TARGET_DIR"
fi

#!/bin/bash
# ==============================================================================
# Script: novnc-start
# Description: Starts native VNC server, noVNC (HTTP/HTTPS), and audio streamer
# Accessible via any web browser at: http(s)://<IP-HP>:6080
# ==============================================================================

export DISPLAY="${DISPLAY:-:0}"
PORT="${PORT:-6080}"
RFBPORT="${RFBPORT:-5900}"

# Parse optional arguments
VNC_PASS=""
NO_PW=false
START_AUDIO=false
USE_SSL=false
ENABLE_POWERSAVE=true
POWERSAVE_TIMEOUT=60

while [ $# -gt 0 ]; do
    case "$1" in
        --passwd|-passwd)
            shift
            VNC_PASS="$1"
            ;;
        --nopw|-nopw)
            NO_PW=true
            ;;
        --port|-p)
            shift
            PORT="$1"
            ;;
        --audio|-audio)
            START_AUDIO=true
            ;;
        --ssl|-ssl)
            USE_SSL=true
            ;;
        --no-powersave)
            ENABLE_POWERSAVE=false
            ;;
        --powersave-timeout)
            shift
            POWERSAVE_TIMEOUT="$1"
            ;;
        --help|-h)
            echo "Penggunaan: novnc-start [opsi]"
            echo "  --audio                 Nyalakan juga server audio web (port 6081)"
            echo "  --ssl                   Aktifkan enkripsi HTTPS/WSS (Self-Signed SSL)"
            echo "  --no-powersave          Matikan penghemat daya otomatis saat idle"
            echo "  --powersave-timeout <s> Ubah batas waktu idle sebelum tidur (default: 60s)"
            echo "  --passwd <kata_sandi>   Gunakan kata sandi sementara untuk sesi ini"
            echo "  --nopw                  Akses tanpa kata sandi (abaikan ~/.vnc/passwd)"
            echo "  --port <port>           Ubah port noVNC web (default: 6080)"
            echo "  --help, -h              Tampilkan bantuan ini"
            exit 0
            ;;
        *)
            ;;
    esac
    shift
done

# Check if X server is actually running
if ! xset q -display "$DISPLAY" >/dev/null 2>&1; then
    echo ""
    echo "============================================================"
    echo " [!] Desktop Termux:X11 belum aktif pada DISPLAY $DISPLAY!"
    echo "============================================================"
    echo " Server noVNC membutuhkan desktop Linux yang sedang berjalan."
    echo ""
    echo " 👉 Untuk menyalakan desktop sekaligus web noVNC, jalankan:"
    echo "    tx11start --novnc"
    echo ""
    echo " 👉 Atau mode background murni (tanpa membuka jendela Termux:X11):"
    echo "    tx11start --novnc --headless"
    echo "    (atau cukup ketik: novnc-headless)"
    echo "============================================================"
    exit 1
fi

# Stop any existing instances first
pkill -9 -f "x0vncserver|x11vnc|websockify.*${PORT}" >/dev/null 2>&1 || true
sleep 0.5

# Detect web root directory
NOVNC_WEB="/usr/share/novnc"
[ -d "/data/data/com.termux/files/usr/share/novnc" ] && NOVNC_WEB="/data/data/com.termux/files/usr/share/novnc"

# Ensure Single-Tab Audio Player is integrated in noVNC web UI
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/patch-novnc-audio.py" ]; then
    python3 "$SCRIPT_DIR/patch-novnc-audio.py" >/dev/null 2>&1 || true
elif [ -f "/data/data/com.termux/files/usr/bin/patch-novnc-audio.py" ]; then
    python3 "/data/data/com.termux/files/usr/bin/patch-novnc-audio.py" >/dev/null 2>&1 || true
elif [ -f "/usr/local/bin/patch-novnc-audio.py" ]; then
    python3 "/usr/local/bin/patch-novnc-audio.py" >/dev/null 2>&1 || true
fi

# Password detection
PASS_FILE=""
if [ -f "$HOME/.vnc/passwd" ]; then
    PASS_FILE="$HOME/.vnc/passwd"
elif [ -f "/data/data/com.termux/files/home/.vnc/passwd" ]; then
    PASS_FILE="/data/data/com.termux/files/home/.vnc/passwd"
elif [ -f "/home/supardi/.vnc/passwd" ]; then
    PASS_FILE="/home/supardi/.vnc/passwd"
fi

PW_STATUS="[🔓] Proteksi Password : Nonaktif (Gunakan 'novnc-passwd' untuk proteksi)"

# Start VNC server (x0vncserver preferred on Termux, x11vnc in Debian)
echo "[i] Menjalankan VNC Server pada DISPLAY $DISPLAY..."
if command -v x0vncserver >/dev/null 2>&1; then
    # TigerVNC x0vncserver
    SEC_OPTS="-SecurityTypes None"
    if [ "$NO_PW" = false ] && [ -n "$PASS_FILE" ]; then
        SEC_OPTS="-SecurityTypes VncAuth -PasswordFile $PASS_FILE"
        PW_STATUS="[🔒] Proteksi Password : Aktif ($PASS_FILE)"
    fi
    setsid x0vncserver -display "$DISPLAY" -rfbport "$RFBPORT" $SEC_OPTS </dev/null >/dev/null 2>&1 &
elif command -v x11vnc >/dev/null 2>&1; then
    # x11vnc
    PW_ARGS="-nopw"
    if [ -n "$VNC_PASS" ]; then
        PW_ARGS="-passwd $VNC_PASS"
        PW_STATUS="[🔒] Proteksi Password : Aktif (Sesi sementara)"
    elif [ "$NO_PW" = false ] && [ -n "$PASS_FILE" ]; then
        PW_ARGS="-rfbauth $PASS_FILE"
        PW_STATUS="[🔒] Proteksi Password : Aktif ($PASS_FILE)"
    fi
    setsid x11vnc -display "$DISPLAY" -forever -shared $PW_ARGS -listen 127.0.0.1 -rfbport "$RFBPORT" -noxdamage </dev/null >/dev/null 2>&1 &
fi

sleep 1

# SSL certificate detection and generation
CERT_FILE=""
if [ -f "$HOME/.vnc/self.pem" ]; then
    CERT_FILE="$HOME/.vnc/self.pem"
elif [ -f "/data/data/com.termux/files/home/.vnc/self.pem" ]; then
    CERT_FILE="/data/data/com.termux/files/home/.vnc/self.pem"
elif [ -f "/home/supardi/.vnc/self.pem" ]; then
    CERT_FILE="/home/supardi/.vnc/self.pem"
else
    CERT_FILE="$HOME/.vnc/self.pem"
fi

if [ "$USE_SSL" = true ]; then
    if [ ! -f "$CERT_FILE" ]; then
        echo "[i] Membuat sertifikat SSL self-signed untuk HTTPS/WSS..."
        mkdir -p "$(dirname "$CERT_FILE")"
        openssl req -new -x509 -days 3650 -nodes \
            -keyout "$CERT_FILE" -out "$CERT_FILE" \
            -subj "/C=ID/ST=Termux/L=Local/O=TermuxDesktop/CN=termux-desktop" \
            -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" 2>/dev/null || \
        openssl req -new -x509 -days 3650 -nodes \
            -keyout "$CERT_FILE" -out "$CERT_FILE" \
            -subj "/CN=termux-desktop" 2>/dev/null
        chmod 600 "$CERT_FILE"
    fi
fi

# Start websockify / noVNC web server using setsid
echo "[i] Menjalankan noVNC Web Server pada port $PORT..."
WEBSOCKIFY_CMD="websockify"
command -v /data/data/com.termux/files/usr/bin/websockify >/dev/null 2>&1 && WEBSOCKIFY_CMD="/data/data/com.termux/files/usr/bin/websockify"

WS_ARGS=("--web" "$NOVNC_WEB")
PROTO="http"
if [ "$USE_SSL" = true ] && [ -f "$CERT_FILE" ]; then
    WS_ARGS+=("--cert" "$CERT_FILE" "--ssl-only")
    PROTO="https"
fi
WS_ARGS+=("$PORT" "127.0.0.1:$RFBPORT")

setsid "$WEBSOCKIFY_CMD" "${WS_ARGS[@]}" </dev/null >/dev/null 2>&1 &
sleep 1

# Start audio streamer if requested
if [ "$START_AUDIO" = true ]; then
    if command -v novnc-audio >/dev/null 2>&1; then
        AUDIO_OPTS=()
        if [ "$USE_SSL" = true ] && [ -f "$CERT_FILE" ]; then
            AUDIO_OPTS+=("--ssl" "--cert" "$CERT_FILE")
        fi
        novnc-audio start "${AUDIO_OPTS[@]}" >/dev/null 2>&1
    fi
fi

# Start Idle Battery Saver if enabled
if [ "$ENABLE_POWERSAVE" = true ]; then
    if command -v novnc-powersave >/dev/null 2>&1; then
        novnc-powersave start --timeout "$POWERSAVE_TIMEOUT" >/dev/null 2>&1
    elif [ -x "$SCRIPT_DIR/novnc-powersave" ]; then
        "$SCRIPT_DIR/novnc-powersave" start --timeout "$POWERSAVE_TIMEOUT" >/dev/null 2>&1
    elif [ -x "/data/data/com.termux/files/usr/bin/novnc-powersave" ]; then
        /data/data/com.termux/files/usr/bin/novnc-powersave start --timeout "$POWERSAVE_TIMEOUT" >/dev/null 2>&1
    fi
fi

# Detect local IP and Tailscale IP
LOCAL_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -vE '127.0.0.1|^100\.' | head -n 1)
[ -z "$LOCAL_IP" ] && LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$LOCAL_IP" ] && LOCAL_IP="<IP-HP-ANDA>"

TAILSCALE_IP=$(ip -4 addr show tailscale0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)
if [ -z "$TAILSCALE_IP" ]; then
    TAILSCALE_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)100\.\d+(\.\d+){2}' | head -n 1)
fi

echo ""
echo "============================================================"
echo " [✓] noVNC Berhasil Dinyalakan!"
echo " $PW_STATUS"
if [ "$PROTO" = "https" ]; then
    echo " [🔒] Protokol Keamanan : HTTPS / WSS (Enkripsi SSL Aktif)"
fi
if [ "$ENABLE_POWERSAVE" = true ]; then
    echo " [🔋] Hemat Daya Idle  : novnc-powersave Aktif (Tidur otomatis jika idle ${POWERSAVE_TIMEOUT}s)"
fi
echo ""
echo " Buka browser di Laptop / PC / Tablet:"
echo "   👉 Layar Desktop : ${PROTO}://${LOCAL_IP}:${PORT}/"
if pgrep -f "novnc-audio-server.py" >/dev/null 2>&1; then
    echo "   👉 Suara Desktop : ${PROTO}://${LOCAL_IP}:6081/ [AKTIF (Speaker HP Senyap)]"
    echo "   🔊 Single-Tab    : Suara dapat diputar LANGSUNG di bilah menu noVNC!"
else
    echo "   👉 Suara Desktop : ${PROTO}://${LOCAL_IP}:6081/ (Ketik 'novnc-audio' untuk aktifkan)"
fi
if [ -n "$TAILSCALE_IP" ]; then
    echo "   👉 Tailscale     : ${PROTO}://${TAILSCALE_IP}:${PORT}/ (Jarak jauh)"
fi
echo "   👉 Lokal HP      : ${PROTO}://localhost:${PORT}/"
echo ""
echo " Perintah terkait:"
echo "   - novnc-powersave: Pantau / atur mode hemat daya baterai"
echo "   - novnc-audio    : Kontrol streaming suara ke browser"
echo "   - novnc-passwd   : Atur / hapus password proteksi"
echo "   - novnc-stop     : Hentikan server noVNC, audio, & powersave"
echo "============================================================"

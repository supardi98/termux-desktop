#!/bin/bash
# ==============================================================================
# Script: novnc-start
# Description: Starts native VNC server and noVNC (websockify) to share Termux Desktop (:0)
# Accessible via any web browser at: http://<IP-HP>:6080
# ==============================================================================

export DISPLAY="${DISPLAY:-:0}"
PORT="${PORT:-6080}"
RFBPORT="${RFBPORT:-5900}"

# Parse optional arguments
VNC_PASS=""
NO_PW=false

while [ $# -gt 0 ]; do
    case "$1" in
        --passwd|-passwd)
            shift
            VNC_PASS="$1"
            ;;
        --nopw|-nopw)
            NO_PW=true
            ;;
        --port|-p)
            shift
            PORT="$1"
            ;;
        --help|-h)
            echo "Penggunaan: novnc-start [opsi]"
            echo "  --passwd <kata_sandi>   Gunakan kata sandi sementara untuk sesi ini"
            echo "  --nopw                  Akses tanpa kata sandi (abaikan ~/.vnc/passwd)"
            echo "  --port <port>           Ubah port noVNC web (default: 6080)"
            echo "  --help, -h              Tampilkan bantuan ini"
            exit 0
            ;;
        *)
            ;;
    esac
    shift
done

# Check if X server is actually running
if ! xset q -display "$DISPLAY" >/dev/null 2>&1; then
    echo ""
    echo "============================================================"
    echo " [!] Desktop Termux:X11 belum aktif pada DISPLAY $DISPLAY!"
    echo "============================================================"
    echo " Server noVNC membutuhkan desktop Linux yang sedang berjalan."
    echo ""
    echo " 👉 Untuk menyalakan desktop sekaligus web noVNC, jalankan:"
    echo "    tx11start --novnc"
    echo ""
    echo " 👉 Atau mode background murni (tanpa membuka jendela Termux:X11):"
    echo "    tx11start --novnc --headless"
    echo "    (atau cukup ketik: novnc-headless)"
    echo "============================================================"
    exit 1
fi

# Stop any existing instances first
pkill -9 -f "x0vncserver|x11vnc|websockify.*${PORT}" >/dev/null 2>&1 || true
sleep 0.5

# Detect web root directory
NOVNC_WEB="/usr/share/novnc"
[ -d "/data/data/com.termux/files/usr/share/novnc" ] && NOVNC_WEB="/data/data/com.termux/files/usr/share/novnc"

# Password detection
PASS_FILE=""
if [ -f "$HOME/.vnc/passwd" ]; then
    PASS_FILE="$HOME/.vnc/passwd"
elif [ -f "/data/data/com.termux/files/home/.vnc/passwd" ]; then
    PASS_FILE="/data/data/com.termux/files/home/.vnc/passwd"
elif [ -f "/home/supardi/.vnc/passwd" ]; then
    PASS_FILE="/home/supardi/.vnc/passwd"
fi

PW_STATUS="[🔓] Proteksi Password : Nonaktif (Gunakan 'novnc-passwd' untuk proteksi)"

# Start VNC server (x0vncserver preferred on Termux, x11vnc in Debian)
echo "[i] Menjalankan VNC Server pada DISPLAY $DISPLAY..."
if command -v x0vncserver >/dev/null 2>&1; then
    # TigerVNC x0vncserver
    SEC_OPTS="-SecurityTypes None"
    if [ "$NO_PW" = false ] && [ -n "$PASS_FILE" ]; then
        SEC_OPTS="-SecurityTypes VncAuth -PasswordFile $PASS_FILE"
        PW_STATUS="[🔒] Proteksi Password : Aktif ($PASS_FILE)"
    fi
    setsid x0vncserver -display "$DISPLAY" -rfbport "$RFBPORT" $SEC_OPTS </dev/null >/dev/null 2>&1 &
elif command -v x11vnc >/dev/null 2>&1; then
    # x11vnc
    PW_ARGS="-nopw"
    if [ -n "$VNC_PASS" ]; then
        PW_ARGS="-passwd $VNC_PASS"
        PW_STATUS="[🔒] Proteksi Password : Aktif (Sesi sementara)"
    elif [ "$NO_PW" = false ] && [ -n "$PASS_FILE" ]; then
        PW_ARGS="-rfbauth $PASS_FILE"
        PW_STATUS="[🔒] Proteksi Password : Aktif ($PASS_FILE)"
    fi
    setsid x11vnc -display "$DISPLAY" -forever -shared $PW_ARGS -listen 127.0.0.1 -rfbport "$RFBPORT" -noxdamage </dev/null >/dev/null 2>&1 &
fi

sleep 1

# Start websockify / noVNC web server using setsid (avoids bionic setgid restrictions)
echo "[i] Menjalankan noVNC Web Server pada port $PORT..."
WEBSOCKIFY_CMD="websockify"
command -v /data/data/com.termux/files/usr/bin/websockify >/dev/null 2>&1 && WEBSOCKIFY_CMD="/data/data/com.termux/files/usr/bin/websockify"

setsid "$WEBSOCKIFY_CMD" --web "$NOVNC_WEB" "$PORT" "127.0.0.1:$RFBPORT" </dev/null >/dev/null 2>&1 &
sleep 1

# Detect local IP and Tailscale IP
LOCAL_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -vE '127.0.0.1|^100\.' | head -n 1)
[ -z "$LOCAL_IP" ] && LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$LOCAL_IP" ] && LOCAL_IP="<IP-HP-ANDA>"

TAILSCALE_IP=$(ip -4 addr show tailscale0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)
if [ -z "$TAILSCALE_IP" ]; then
    TAILSCALE_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)100\.\d+(\.\d+){2}' | head -n 1)
fi

echo ""
echo "============================================================"
echo " [✓] noVNC Berhasil Dinyalakan!"
echo " $PW_STATUS"
echo ""
echo " Buka browser di Laptop / PC / Tablet:"
echo "   👉 Wi-Fi Lokal : http://${LOCAL_IP}:${PORT}"
if [ -n "$TAILSCALE_IP" ]; then
    echo "   👉 Tailscale   : http://${TAILSCALE_IP}:${PORT} (Akses jarak jauh)"
else
    echo "   👉 Tailscale   : http://<IP-Tailscale-HP>:${PORT} (Jika aktif)"
fi
echo "   👉 Lokal HP    : http://localhost:${PORT}"
echo ""
echo " Perintah terkait:"
echo "   - novnc-passwd : Atur / hapus password proteksi"
echo "   - novnc-stop   : Hentikan server noVNC"
echo "============================================================"

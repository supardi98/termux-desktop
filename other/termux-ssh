#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# Script: termux-ssh
# Description: Starts/Stops SSH server (sshd) on port 8022 with Tailscale & Wi-Fi info
# Usage: termux-ssh [start|stop|status|restart]
# ==============================================================================

readonly TERMUX_HOME=${HOME:-/data/data/com.termux/files/home}
MARKER_FILE="$TERMUX_HOME/.first_pass_change_marker"
SSH_PORT=8022

get_user() {
    local u
    if [ -x "/data/data/com.termux/files/usr/bin/whoami" ]; then
        u=$(/data/data/com.termux/files/usr/bin/whoami 2>/dev/null)
    fi
    [ -z "$u" ] && u=$(whoami 2>/dev/null)
    [ -z "$u" ] && u="u0_a331"
    echo "$u"
}

get_ips() {
    LOCAL_IP=$(ip -4 addr show wlan0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)
    [ -z "$LOCAL_IP" ] && LOCAL_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -vE '127.0.0.1|^100\.' | head -n 1)
    [ -z "$LOCAL_IP" ] && LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -z "$LOCAL_IP" ] && LOCAL_IP="<IP-HP-ANDA>"

    TAILSCALE_IP=$(ip -4 addr show tailscale0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)
    if [ -z "$TAILSCALE_IP" ]; then
        TAILSCALE_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)100\.\d+(\.\d+){2}' | head -n 1)
    fi
}

ensure_sshd_config() {
    local conf_dir="/data/data/com.termux/files/usr/etc/ssh/sshd_config.d"
    local conf_file="$conf_dir/termux.conf"
    local pts_fix="/data/data/com.termux/files/usr/lib/libssh_pts_fix.so"
    local sshd_session="/data/data/com.termux/files/usr/libexec/sshd-session"

    if [ ! -d "$conf_dir" ]; then
        mkdir -p "$conf_dir" 2>/dev/null
    fi
    if [ ! -f "$conf_file" ]; then
        cat << 'EOF' > "$conf_file" 2>/dev/null
# Termux SSH optimization
PasswordAuthentication yes
KbdInteractiveAuthentication yes
PerSourcePenalties no
EOF
    fi

    if [ ! -f "$pts_fix" ] && [ -x "/data/data/com.termux/files/usr/bin/clang" ]; then
        local src="/home/supardi/termux-desktop/other/ssh_pts_fix.c"
        if [ -f "$src" ]; then
            /data/data/com.termux/files/usr/bin/clang -shared -fPIC -O2 "$src" -o "$pts_fix" 2>/dev/null
        fi
    fi

    if [ -f "$pts_fix" ] && [ -f "$sshd_session" ] && command -v patchelf >/dev/null 2>&1; then
        if ! patchelf --print-needed "$sshd_session" 2>/dev/null | grep -q "libssh_pts_fix.so"; then
            patchelf --add-needed libssh_pts_fix.so "$sshd_session" 2>/dev/null
        fi
    fi
}

start_ssh() {
    ensure_sshd_config
    if ! pgrep -x sshd >/dev/null 2>&1; then
        env -i PATH=/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/bin/applets \
               HOME=/data/data/com.termux/files/home \
               PREFIX=/data/data/com.termux/files/usr \
               TMPDIR=/data/data/com.termux/files/usr/tmp \
               /data/data/com.termux/files/usr/bin/sshd
        sleep 0.5
    fi

    if pgrep -x sshd >/dev/null 2>&1; then
        get_ips
        local USER_NAME
        USER_NAME=$(get_user)

        echo ""
        echo "============================================================"
        echo " [✓] Server SSH (sshd) Aktif pada Port $SSH_PORT"
        echo "============================================================"
        echo " Pengguna (Username) : $USER_NAME"
        echo ""
        echo " Cara akses dari Laptop / PC / Terminal lain:"
        echo "   👉 Wi-Fi Lokal : ssh -p $SSH_PORT ${USER_NAME}@${LOCAL_IP}"
        if [ -n "$TAILSCALE_IP" ]; then
            echo "   👉 Tailscale   : ssh -p $SSH_PORT ${USER_NAME}@${TAILSCALE_IP} (Jarak Jauh)"
        fi
        echo "   👉 Lokal HP    : ssh -p $SSH_PORT ${USER_NAME}@localhost"
        echo ""
        echo " Tips Akses:"
        echo "   - Ubah Password : Ketik 'termux-ssh passwd' untuk mengatur/mengubah password SSH Termux"
        echo "   - SSH Key       : Salin id_ed25519.pub ke ~/.ssh/authorized_keys (Rekomendasi, tanpa password)"
        echo "   - Masuk Debian  : Setelah login ke Termux via SSH, ketik 'pdrun' untuk masuk Debian"
        echo "   - Catatan       : Jika password salah, OpenSSH otomatis memutus koneksi (Connection closed)"
        echo "   - SFTP          : Host ${LOCAL_IP}, Port $SSH_PORT (FileZilla/WinSCP/VS Code)"
        echo "============================================================"
    else
        echo "[☓] Gagal menjalankan sshd."
        return 1
    fi
}

stop_ssh() {
    if pgrep -x sshd >/dev/null 2>&1; then
        pkill -x sshd
        sleep 0.5
        echo "[✓] Server SSH (sshd) telah dihentikan."
    else
        echo "[i] Server SSH (sshd) tidak sedang berjalan."
    fi
}

status_ssh() {
    if pgrep -x sshd >/dev/null 2>&1; then
        get_ips
        local USER_NAME
        USER_NAME=$(get_user)
        echo "[✓] Server SSH (sshd): AKTIF pada port $SSH_PORT"
        echo "    Username : $USER_NAME"
        echo "    Wi-Fi    : ssh -p $SSH_PORT ${USER_NAME}@${LOCAL_IP}"
        if [ -n "$TAILSCALE_IP" ]; then
            echo "    Tailscale: ssh -p $SSH_PORT ${USER_NAME}@${TAILSCALE_IP}"
        fi
        if [ ! -f "$TERMUX_HOME/.termux_authinfo" ] && [ ! -s "$TERMUX_HOME/.ssh/authorized_keys" ]; then
            echo "    [!] Catatan: Password SSH belum diatur! Ketik 'termux-ssh passwd' untuk membuat password."
        fi
    else
        echo "[x] Server SSH (sshd): TIDAK AKTIF (Jalankan 'termux-ssh start' atau 'startssh')"
    fi
}

set_termux_passwd() {
    echo "[i] Menjalankan pengaturan password SSH Termux..."
    if [ -x "/data/data/com.termux/files/usr/bin/passwd" ]; then
        /data/data/com.termux/files/usr/bin/passwd
    else
        passwd
    fi
}

case "$1" in
    start)
        start_ssh
        ;;
    stop)
        stop_ssh
        ;;
    restart)
        stop_ssh
        sleep 1
        start_ssh
        ;;
    status)
        status_ssh
        ;;
    passwd)
        set_termux_passwd
        ;;
    --help|-h)
        echo "Penggunaan: termux-ssh [start|stop|restart|status|passwd]"
        echo "  start    - Nyalakan server SSH (port 8022)"
        echo "  stop     - Matikan server SSH"
        echo "  status   - Cek status dan perintah koneksi SSH"
        echo "  passwd   - Set / ubah password SSH Termux (~/.termux_authinfo)"
        echo "Aliases: startssh, stopssh"
        ;;
    *)
        if [[ ! -f "$TERMUX_HOME/.termux_authinfo" && ! -s "$TERMUX_HOME/.ssh/authorized_keys" ]]; then
            echo "[i] Konfigurasi awal: Silakan atur password login SSH Termux:"
            set_termux_passwd
        fi
        start_ssh
        ;;
esac

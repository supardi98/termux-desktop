#!/bin/bash
# ==============================================================================
# Script: novnc-stop
# Description: Stops x0vncserver, x11vnc, and noVNC (websockify)
# ==============================================================================

pkill -9 -f "x0vncserver|x11vnc|websockify.*6080" >/dev/null 2>&1 || true
echo "[✓] Server noVNC dan VNC Server telah berhasil dihentikan."

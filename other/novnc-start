#!/bin/bash
# ==============================================================================
# Script: novnc-start
# Description: Starts x11vnc and noVNC (websockify) to share Termux Desktop (DISPLAY :0)
# Accessible via any web browser at: http://<IP-HP>:6080
# ==============================================================================

export DISPLAY="${DISPLAY:-:0}"

# Stop any existing instances first
pkill -9 -f "x11vnc|websockify.*6080" >/dev/null 2>&1 || true

# Start x11vnc attached to DISPLAY :0 on port 5900 (loopback only for security)
echo "[i] Menjalankan x11vnc pada DISPLAY $DISPLAY..."
x11vnc -display "$DISPLAY" -forever -shared -nopw -listen 127.0.0.1 -rfbport 5900 -noxdamage -bg >/dev/null 2>&1

# Start websockify / noVNC web server on port 6080
echo "[i] Menjalankan noVNC Web Server pada port 6080..."
websockify --web /usr/share/novnc 6080 127.0.0.1:5900 >/dev/null 2>&1 &

# Get local IP address
LOCAL_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -n 1)
[ -z "$LOCAL_IP" ] && LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$LOCAL_IP" ] && LOCAL_IP="<IP-HP-ANDA>"

echo ""
echo "============================================================"
echo " [✓] noVNC Berhasil Dinyalakan!"
echo " Buka browser di Laptop / PC (dalam satu jaringan Wi-Fi/Hotspot):"
echo ""
echo "       👉 http://${LOCAL_IP}:6080"
echo ""
echo " Untuk mematikan noVNC, jalankan perintah: novnc-stop"
echo "============================================================"

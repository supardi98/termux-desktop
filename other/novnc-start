#!/bin/bash
# ==============================================================================
# Script: novnc-start
# Description: Starts x11vnc and noVNC (websockify) to share Termux Desktop (DISPLAY :0)
# Accessible via any web browser at: http://<IP-HP>:6080
# ==============================================================================

# If executed from Termux host (outside PRoot), forward into Debian container
if [ ! -f /etc/debian_version ]; then
    if command -v pdrun >/dev/null 2>&1; then
        exec pdrun novnc-start "$@"
    fi
fi

export DISPLAY="${DISPLAY:-:0}"
PORT="${PORT:-6080}"
RFBPORT="${RFBPORT:-5900}"

# Parse optional arguments
VNC_PASS=""
NO_PW=false

while [ $# -gt 0 ]; do
    case "$1" in
        --passwd|-passwd)
            shift
            VNC_PASS="$1"
            ;;
        --nopw|-nopw)
            NO_PW=true
            ;;
        --port|-p)
            shift
            PORT="$1"
            ;;
        --help|-h)
            echo "Penggunaan: novnc-start [opsi]"
            echo "  --passwd <kata_sandi>   Gunakan kata sandi sementara untuk sesi ini"
            echo "  --nopw                  Akses tanpa kata sandi (abaikan ~/.vnc/passwd)"
            echo "  --port <port>           Ubah port noVNC web (default: 6080)"
            echo "  --help, -h              Tampilkan bantuan ini"
            exit 0
            ;;
        *)
            ;;
    esac
    shift
done

# Check if X server is actually running before starting VNC
if ! xset q -display "$DISPLAY" >/dev/null 2>&1; then
    echo ""
    echo "============================================================"
    echo " [!] Desktop Termux:X11 belum aktif pada DISPLAY $DISPLAY!"
    echo "============================================================"
    echo " Server noVNC membutuhkan desktop Linux yang sedang berjalan."
    echo ""
    echo " 👉 Untuk menyalakan desktop sekaligus web noVNC, jalankan:"
    echo "    tx11start --novnc"
    echo ""
    echo " 👉 Atau mode background murni (tanpa membuka jendela Termux:X11):"
    echo "    tx11start --novnc --headless"
    echo "    (atau cukup ketik: novnc-headless)"
    echo "============================================================"
    exit 1
fi

# Stop any existing instances first
pkill -9 -f "x11vnc|websockify.*${PORT}" >/dev/null 2>&1 || true

# Determine password settings
PW_ARGS="-nopw"
PW_STATUS="[🔓] Proteksi Password : Nonaktif (Gunakan 'novnc-passwd' untuk proteksi)"

if [ -n "$VNC_PASS" ]; then
    PW_ARGS="-passwd $VNC_PASS"
    PW_STATUS="[🔒] Proteksi Password : Aktif (Sesi sementara)"
elif [ "$NO_PW" = false ] && [ -f "$HOME/.vnc/passwd" ]; then
    PW_ARGS="-rfbauth $HOME/.vnc/passwd"
    PW_STATUS="[🔒] Proteksi Password : Aktif (~/.vnc/passwd)"
fi

# Start x11vnc attached to DISPLAY on loopback only for security
echo "[i] Menjalankan x11vnc pada DISPLAY $DISPLAY..."
x11vnc -display "$DISPLAY" -forever -shared $PW_ARGS -listen 127.0.0.1 -rfbport "$RFBPORT" -noxdamage -bg >/dev/null 2>&1
sleep 1

if ! pgrep -f "x11vnc.*${RFBPORT}" >/dev/null 2>&1; then
    echo "[☓] Gagal menjalankan x11vnc. Periksa koneksi DISPLAY $DISPLAY."
    exit 1
fi

# Start websockify / noVNC web server
echo "[i] Menjalankan noVNC Web Server pada port $PORT..."
websockify -D --web /usr/share/novnc "$PORT" "127.0.0.1:$RFBPORT" >/dev/null 2>&1

# Detect local IP and Tailscale IP
LOCAL_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -vE '127.0.0.1|^100\.' | head -n 1)
[ -z "$LOCAL_IP" ] && LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$LOCAL_IP" ] && LOCAL_IP="<IP-HP-ANDA>"

TAILSCALE_IP=$(ip -4 addr show tailscale0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)
if [ -z "$TAILSCALE_IP" ]; then
    TAILSCALE_IP=$(ip -4 addr show 2>/dev/null | grep -oP '(?<=inet\s)100\.\d+(\.\d+){2}' | head -n 1)
fi

echo ""
echo "============================================================"
echo " [✓] noVNC Berhasil Dinyalakan!"
echo " $PW_STATUS"
echo ""
echo " Buka browser di Laptop / PC / Tablet:"
echo "   👉 Wi-Fi Lokal : http://${LOCAL_IP}:${PORT}"
if [ -n "$TAILSCALE_IP" ]; then
    echo "   👉 Tailscale   : http://${TAILSCALE_IP}:${PORT} (Akses jarak jauh)"
else
    echo "   👉 Tailscale   : http://<IP-Tailscale-HP>:${PORT} (Jika aktif)"
fi
echo "   👉 Lokal HP    : http://localhost:${PORT}"
echo ""
echo " Perintah terkait:"
echo "   - novnc-passwd : Atur / hapus password proteksi"
echo "   - novnc-stop   : Hentikan server noVNC"
echo "============================================================"
